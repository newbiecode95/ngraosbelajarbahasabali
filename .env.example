POSTGRES_PASSWORD=CHANGE_ME
BETTER_AUTH_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPENROUTER_API_KEY=
AI_ROLEPLAY_MODEL=
